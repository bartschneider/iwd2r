      "name": "macos-clang",
      "configurePreset": "macos-clang",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-msvc-x64",
      "configurePreset": "windows-msvc-x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-x86",
      "configurePreset": "windows-msvc-x86",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "configuration": "RelWithDebInfo"
