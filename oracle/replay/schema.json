{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iwd2r replay state dump",
  "description": "One state dump of a replay: frame-<N>.json every IWD2R_DUMP_EVERY frames and checkpoint-<NAME>.json at a scenario's checkpoint lines. The recorder (oracle/replay/recorder.cpp) writes it from the original; Task 13's platform/state_dump writes it from our engine. x-fields names where each value lives; tools/gen_fields.py turns it into fields.json with the offsets from our headers' /* NNNN */ comments.",
  "type": "object",
  "required": [
    "frame",
    "screen",
    "rng_state",
    "globals",
    "chargen",
    "world"
  ],
  "additionalProperties": false,
  "properties": {
    "frame": {
      "description": "Frames since the start: one per call of the main thread's per-frame function (CBaldurChitin::SynchronousUpdate in the original) that the frame gate counts (platform/replay_clock.h FrameGate: not the calls drawn while the AI thread is inside an update, as a load draws its progress).",
      "type": "integer",
      "minimum": 0
    },
    "checkpoint": {
      "description": "The checkpoint's name, in checkpoint dumps only.",
      "type": "string"
    },
    "screen": {
      "description": "The active engine (CChitin::pActiveEngine) named by the CBaldurChitin::m_pEngine* member it equals; none when there is no active engine, unknown when it is none of them.",
      "type": "string",
      "enum": [
        "none",
        "unknown",
        "dm",
        "projector",
        "character",
        "create_char",
        "inventory",
        "journal",
        "load",
        "map",
        "options",
        "save",
        "spellbook",
        "start",
        "world",
        "store",
        "single_player",
        "connection",
        "world_map",
        "chapter",
        "movies",
        "keymaps"
      ]
    },
    "rng_state": {
      "description": "The main thread's rand state (_tiddata._holdrand in the original's VC6 CRT).",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "globals": {
      "type": "object",
      "required": [
        "au_counter",
        "fullscreen",
        "in_async_update",
        "ai_stalled_frames",
        "reinitializing",
        "loading",
        "loads",
        "held_frames",
        "ai_rng_state"
      ],
      "additionalProperties": false,
      "properties": {
        "au_counter": {
          "description": "CChitin::nAUCounter: AI updates (AsynchronousUpdate calls) so far.",
          "type": "integer"
        },
        "fullscreen": {
          "description": "CChitin::m_bFullscreen.",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "in_async_update": {
          "description": "CChitin::m_bInAsynchronousUpdate: nonzero when the dump was taken while the AI thread was inside an AsynchronousUpdate. The frame gate holds every such call, so a dump always has 0.",
          "type": "integer"
        },
        "ai_stalled_frames": {
          "description": "Frames so far with no AI update since the previous frame. The virtual clock wakes the AI thread once per frame, so every frame has an AI update of its own (au_counter goes up); frames drawn from inside an update (a load redrawing its progress) are held, not counted (held_frames). A stall means the AI thread ran without counting (m_bReInitializing after a focus loss) or not at all.",
          "type": "integer",
          "minimum": 0
        },
        "reinitializing": {
          "description": "CChitin::m_bReInitializing: nonzero while the game is not updating (OnAltTab(FALSE) on focus loss sets it, and AsynchronousUpdate then neither counts nor polls input).",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "loading": {
          "description": "CChitin::cProgressBar.m_bProgressBarActivated: nonzero while the progress screen of a load is up (CBaldurChitin::SetProgressBar 0x425710 sets and clears it; CChitin::SynchronousUpdate 0x790B70 then draws the progress screen instead of the engine). tools/oracle.py fails a checkpoint dump taken while it is set.",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "loads": {
          "description": "Loads so far: AI updates during which the main thread drew a frame from inside the update while the progress bar was up (platform/replay_clock.h FrameGate). Such frames are held: not counted, no clock step, no timers.",
          "type": "integer",
          "minimum": 0
        },
        "held_frames": {
          "description": "Calls of the per-frame function held so far (platform/replay_clock.h FrameGate): drawn while the AI thread was inside an update, as a load redraws its progress. Their number depends on the machine's speed; they are not frames, the clock does not move for them and no timer fires.",
          "type": "integer",
          "minimum": 0
        },
        "ai_rng_state": {
          "description": "The rand state (_holdrand) of the thread that polls input, the AI thread in the original (CChitin::AsynchronousUpdate calls GetCursorPos there), which is where clicks and key presses, and so character generation, call rand; null until that thread has polled input once. VC6 starts every thread at 1; it is not seeded.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "description": "The recorder's invariant (tools/oracle.py checks it on every checkpoint dump): reinitializing, ai_stalled_frames, in_async_update and loading are 0. au_counter follows frame one for one, never behind by a stall; held_frames is timing, loads is compared."
    },
    "chargen": {
      "description": "Character generation, null unless the screen is create_char. The sprite values are null while the screen has no sprite (m_nGameSprite does not resolve in the object array).",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "race",
        "subrace",
        "class",
        "abilities",
        "rolls",
        "skill_points",
        "feats",
        "portrait"
      ],
      "additionalProperties": false,
      "properties": {
        "race": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255,
          "description": "The sprite's m_startTypeAI.m_nRace."
        },
        "subrace": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255,
          "description": "m_startTypeAI.m_nSubRace."
        },
        "class": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255,
          "description": "m_startTypeAI.m_nClass."
        },
        "abilities": {
          "description": "m_baseStats.m_STRBase, DEX, CON, INT, WIS, CHR; null without a sprite.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 6,
          "maxItems": 6
        },
        "rolls": {
          "description": "The screen's stored ability set (CScreenCreateChar::m_nMemorySTR, DEX, CON, INT, WIS, CHR, then m_nMemoryExtra). IWD2 abilities are point-buy; these are the only stored roll values.",
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 7,
          "maxItems": 7
        },
        "skill_points": {
          "description": "CScreenCreateChar::m_nExtraSkillPoints.",
          "type": "integer"
        },
        "feats": {
          "description": "The sprite's m_baseStats.m_feats bit masks (3 dwords); null without a sprite.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "minItems": 3,
          "maxItems": 3
        },
        "portrait": {
          "description": "The sprite's m_baseStats.m_portraitLarge resref; null without a sprite.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "world": {
      "description": "The world screen, null unless the screen is world: the area on view and the party. A party member's values are null while its id does not resolve in the object array.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "area",
        "party"
      ],
      "additionalProperties": false,
      "properties": {
        "area": {
          "description": "The resref of CInfGame::m_gameAreas[m_visibleArea] (CInfGame::GetVisibleArea), its CGameArea::m_resRef; \"\" when there is no area on view.",
          "type": "string"
        },
        "party": {
          "description": "The party in portrait order: CInfGame::m_characterPortraits[0 .. m_nCharacters - 1] (CInfGame::GetCharacterId).",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "id",
              "x",
              "y",
              "hp",
              "max_hp",
              "skills"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "The object id (m_characterPortraits[i]).",
                "type": "integer"
              },
              "x": {
                "description": "CGameObject::m_pos.x.",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "y": {
                "description": "CGameObject::m_pos.y.",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "hp": {
                "description": "The current hit points, m_baseStats.m_hitPoints.",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "max_hp": {
                "description": "The maximum hit points, m_derivedStats.m_nMaxHitPoints.",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "skills": {
                "description": "m_derivedStats.m_nSkills, the 64 skill bytes as signed chars, as the original reads them (movsx).",
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "integer",
                  "minimum": -128,
                  "maximum": 127
                },
                "minItems": 64,
                "maxItems": 64
              }
            }
          }
        }
      }
    }
  },
