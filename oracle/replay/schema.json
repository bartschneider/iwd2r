    },
    "engine_connection": {
      "class": "CBaldurChitin",
      "member": "m_pEngineConnection"
    },
    "engine_world_map": {
      "class": "CBaldurChitin",
      "member": "m_pEngineWorldMap"
    },
    "engine_chapter": {
