    },
    "engine_movies": {
      "class": "CBaldurChitin",
      "member": "m_pEngineMovies"
    },
    "engine_keymaps": {
      "class": "CBaldurChitin",
      "member": "m_pEngineKeymaps"
    },
    "objects_array": {
      "class": "CInfGame",
      "member": "m_cObjectArray.m_pArray"
    },
    "objects_max_index": {
      "class": "CInfGame",
      "member": "m_cObjectArray.m_nMaxArrayIndex"
    },
    "objects_next_id": {
      "class": "CInfGame",
      "member": "m_cObjectArray.m_nNextObjectId"
    },
    "object_entry_id": {
      "class": "CGameObjectArrayEntry",
      "member": "m_objectId"
    },
    "object_entry_ptr": {
      "class": "CGameObjectArrayEntry",
      "member": "m_objectPtr"
    },
    "object_entry_size": {
      "class": "CGameObjectArrayEntry",
      "sizeof": true
    },
    "create_char_sprite": {
      "class": "CScreenCreateChar",
      "member": "m_nGameSprite"
    },
    "create_char_skill_points": {
