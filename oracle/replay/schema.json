    },
    "engine_world": {
      "class": "CBaldurChitin",
      "member": "m_pEngineWorld"
    },
    "engine_store": {
      "class": "CBaldurChitin",
      "member": "m_pEngineStore"
    },
    "engine_single_player": {
      "class": "CBaldurChitin",
